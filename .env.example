# Copy to .env.local (git-ignored) and fill in.

# Used only by scripts/db.mjs (schema, seed, tests) on your computer.
# Supabase dashboard > Connect > Session pooler > URI (contains the database password).
SUPABASE_DB_URL=

# Browser app (stage 2). The anon key is public by design; RLS protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put the service_role key here or anywhere in the repo.
# It lives only as a Supabase Edge Function secret.
